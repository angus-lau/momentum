STRIPE_LIVE_KEY=<your-stripe-restricted-key>

# Xoro ERP login (used by xoro_login.py to mint/refresh the session cookie)
XORO_USERNAME=your-xoro-username
XORO_PASSWORD=your-xoro-password
# XORO_COOKIE is written automatically by xoro_login.login() — no need to set it by hand.

# Wise API personal access token (Settings > API tokens in Wise), used by wise_statements.py
WISE_API_KEY=your-wise-api-token
